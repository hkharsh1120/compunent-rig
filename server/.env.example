# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
MONGO_URI=your_mongodb_connection_string

# Authentication
# JWT_EXPIRES_IN accepts jsonwebtoken-style durations: 7d, 12h, 30m, etc.
# The auth cookie maxAge is derived from this same value.
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin seed account (used by scripts/seedAdmin.js)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_12_char_password
